# Copy this file to .env and fill in your credentials

# Vedak CRM Application URL
APP_URL=http://localhost:5173

# Gmail Credentials (for OAuth testing)
# Email to use for login testing
GMAIL_EMAIL=vivek.k@vedak.com

# Gmail Password or App Password
# For Gmail App Password: https://myaccount.google.com/apppasswords
# This is required for automated OAuth testing
GMAIL_PASSWORD=your_gmail_password_or_app_password

# Playwright Configuration
# Run tests in headless mode (false = show browser)
HEADLESS=false

# Slow down test execution to see what's happening (milliseconds)
SLOW_MO=100

# Test Timeout (milliseconds)
TIMEOUT=30000

# Screenshot Configuration
SCREENSHOT_PATH=./screenshots
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ON_SUCCESS=false

# Report Configuration
REPORT_PATH=./reports
REPORT_FORMAT=html

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/test-execution.log

# Video Recording
RECORD_VIDEO=false
VIDEO_PATH=./screenshots/videos

# Network Throttling (for edge case tests)
# Options: 'slow-4g', 'fast-3g', 'slow-3g', 'slow-2g'
NETWORK_PROFILE=slow-4g

# Test Data
VALID_TEST_ACCOUNT=vivek.k@vedak.com
INVALID_TEST_ACCOUNTS=user@gmail.com,test@yahoo.com,user@company.com

# Performance Thresholds
MAX_PAGE_LOAD_TIME=3000

# Retry Configuration
RETRY_FAILED_TESTS=1
RETRY_COUNT=3

# Parallel Execution
MAX_WORKERS=1
PARALLEL_TESTS=false

# Browser Selection
# Options: 'chromium', 'firefox', 'webkit'
BROWSER=chromium
